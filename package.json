{
  "name": "sketchboard",
  "version": "0.2.0-rc.1",
  "description": "A clean digital sketchboard for drawing, images, text and workflow boards.",
  "main": "src/main.js",
  "scripts": {
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer/renderer.js",
    "dist:linux": "electron-builder --linux --x64",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64",
    "icon": "electron scripts/generate-icon.js",
    "pack": "electron-builder --dir",
    "start": "electron ."
  },
  "keywords": [
    "electron",
    "sketchboard",
    "whiteboard",
    "drawing"
  ],
  "author": "Kaiky Netto and Raphael Xavier",
  "license": "MIT",
  "build": {
    "appId": "com.kaikynetto.sketchboard",
    "productName": "Sketchboard",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "Sketchboard-${version}-${os}-${arch}.${ext}",
    "linux": {
      "category": "Graphics",
      "maintainer": "Sketchboard contributors <noreply@github.com>",
      "synopsis": "A clean digital sketchboard",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "homepage": "https://github.com/kaikynetto/sketchboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaikynetto/sketchboard.git"
  },
  "bugs": {
    "url": "https://github.com/kaikynetto/sketchboard/issues"
  }
}
